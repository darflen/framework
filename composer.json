{
    "name": "darflen/framework",
    "description": "Framework used for the Darflen social media project.",
    "keywords": ["framework","darflen"],
    "type": "library",
    "license": "GPL-3.0-only",
    "homepage": "https://darflen.com",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Darflen\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darflen\\Framework\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2"
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
