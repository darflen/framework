{
    "name": "darflen/framework",
    "description": "Framework used for the Darflen social media project.",
    "keywords": ["framework","darflen"],
    "type": "library",
    "license": "GPL-3.0-only",
    "homepage": "https://darflen.com",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Darflen\\Framework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darflen\\Framework\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2"
    },
    "scripts": {
        "test:phpunit": "vendor/bin/phpunit --testdox",
        "test:phpstan": "vendor/bin/phpstan analyse",
        "test:coverage": "php -d zend_extension=\"xdebug\" -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text",
        "test": [
            "@test:phpunit",
            "@test:phpstan"
        ],
        "optimize": "composer dump-autoload -o"
    },
    "config": {
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
